# Vercel > Settings > Environment Variables 에 넣는다. 이 파일 자체는 올려도 되지만 .env 는 올리지 않는다.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # 서버 전용. 브라우저에 절대 노출 금지

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini          # 선택

# 검색 (없으면 검색 없이 "확인할 수 없음"으로 답한다)
BRAVE_API_KEY=

# pg_cron 이 tick 을 부를 때 쓰는 비밀값. 10_cron.sql 의 <CRON_SECRET> 과 같게
CRON_SECRET=

# 앱 자체 알림 (VAPID 연락처). 선택
PUSH_CONTACT=mailto:you@example.com

# ntfy 예비 알림 서버. 선택
NTFY_SERVER=https://ntfy.sh

# ---------- 운영 (선택) ----------
# 몰랑이의 자식(heir)을 켤 수 있는 단 한 계정의 이메일. 비우면 아무도 새로 켤 수 없다 (이미 켠 계정은 유지)
HEIR_OWNER_EMAIL=
# 대화 속도 제한 (비용 폭주 방지)
CHAT_PER_MIN=10
CHAT_PER_DAY=300
# AI 응답 시간 제한(초)
LLM_TIMEOUT=25
# 1 이면 오류 응답에 내부 정보(종류·파일·줄)를 담는다. 개발할 때만. 출시 후엔 꼭 비울 것
DEBUG_ERRORS=
